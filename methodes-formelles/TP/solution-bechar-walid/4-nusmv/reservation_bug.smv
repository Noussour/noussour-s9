-- Reservation de la derniere place par deux utilisateurs : VERSION INCORRECTE.
-- La reservation se fait en deux etapes non atomiques :
--   1. verifier : l'utilisateur lit "libres > 0" et passe dans l'etat interne 'verifiee'
--   2. confirmer : il decremente libres SANS reverifier
-- Entre les deux, l'autre utilisateur peut aussi verifier : les deux obtiennent la place.
-- Execution : NuSMV reservation_bug.smv  (les proprietes de surete S1 et S3 sont FAUSSES)

MODULE main
VAR
  u1     : {attente, verifiee, confirmee, refusee, annulee};
  u2     : {attente, verifiee, confirmee, refusee, annulee};
  libres : -1..1;        -- capacite N = 1. La valeur -1 signale une sur-reservation.
  qui    : {1, 2};

DEFINE
  N := 1;
  nb_confirmees := toint(u1 = confirmee) + toint(u2 = confirmee);

ASSIGN
  init(u1)     := attente;
  init(u2)     := attente;
  init(libres) := N;

  next(u1) := case
    qui = 1 & u1 = attente & libres > 0 : {verifiee, annulee};
    qui = 1 & u1 = attente              : {refusee, annulee};
    qui = 1 & u1 = verifiee             : confirmee;              -- pas de nouvelle verification
    qui = 1 & u1 = confirmee            : {confirmee, annulee};
    TRUE                                : u1;
  esac;

  next(u2) := case
    qui = 2 & u2 = attente & libres > 0 : {verifiee, annulee};
    qui = 2 & u2 = attente              : {refusee, annulee};
    qui = 2 & u2 = verifiee             : confirmee;
    qui = 2 & u2 = confirmee            : {confirmee, annulee};
    TRUE                                : u2;
  esac;

  -- Les gardes sur libres ne servent qu'a rester dans le domaine -1..1.
  -- "libres >= 0" n'est PAS une reverification : elle laisse passer libres = 0, d'ou le -1.
  next(libres) := case
    u1 = verifiee  & next(u1) = confirmee & libres >= 0 : libres - 1;   -- decrementation tardive
    u2 = verifiee  & next(u2) = confirmee & libres >= 0 : libres - 1;
    u1 = confirmee & next(u1) = annulee   & libres < N  : libres + 1;
    u2 = confirmee & next(u2) = annulee   & libres < N  : libres + 1;
    TRUE                                                : libres;
  esac;

FAIRNESS qui = 1;
FAIRNESS qui = 2;

-- Memes proprietes que la version correcte
SPEC AG (libres >= 0 & libres <= N)                -- S1 : FAUSSE
SPEC AG (libres + nb_confirmees = N)               -- S2
SPEC AG !(u1 = confirmee & u2 = confirmee)         -- S3 : FAUSSE (double reservation)
SPEC AG (u1 = attente -> AF u1 != attente)         -- V1
LTLSPEC F (u1 != attente & u2 != attente)          -- V3
